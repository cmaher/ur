#!/usr/bin/env bash
set -euo pipefail

# Pre-push hook: run CI checks, build images, and run acceptance tests.
# Install with: cargo make install-hooks
#
# Output is captured to a stable log file. The log is removed on success
# and preserved on failure so you can read the full output.

# Git exports repo-local variables (GIT_DIR, GIT_INDEX_FILE, ...) to hooks; from
# a linked worktree GIT_DIR points at .git/worktrees/<name>. Tests that run git
# in temp repos (builderd pool_handler) would inherit it and operate on this
# repo instead, so clear them before running anything.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

mkdir -p tmp
LOGFILE=$(mktemp tmp/ur-pre-push.XXXXXX)

# Prune target/ and Docker build cache on every exit, pass or fail: a full disk
# is usually what made the push fail in the first place. The hook is shared by
# every checkout of the repo, so tolerate one without the script, and never let
# housekeeping change the push's exit status.
# shellcheck disable=SC2154 # rc is assigned inside the trap string
trap 'rc=$?; if [ -x scripts/build/housekeeping.sh ]; then scripts/build/housekeeping.sh || true; fi; exit $rc' EXIT

# Capture the branch being pushed from stdin (format: <local ref> <local sha> <remote ref> <remote sha>)
while IFS=' ' read -r local_ref _local_sha _remote_ref _remote_sha; do
    export UR_PUSH_BRANCH="${local_ref#refs/heads/}"
    break
done

run_step() {
    local label="$1"
    shift
    if ! "$@" >>"$LOGFILE" 2>&1; then
        echo "pre-push FAILED: $label" >&2
        echo "--- last 100 lines (full log: $LOGFILE) ---" >&2
        tail -100 "$LOGFILE" >&2
        exit 1
    fi
}

# clippy runs with --locked, which also verifies Cargo.lock is up to date.
run_step "CI (fmt + clippy + build + test)" cargo make ci
run_step "image build + acceptance" cargo make acceptance-ci

rm -f "$LOGFILE"
